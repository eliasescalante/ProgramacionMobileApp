<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Firebase Authentication y Cloud Firestore se comunican por HTTPS. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- NetworkMonitor: detectar caída/retorno de la red para reintentar. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!--
      allowBackup=false: la base Room contiene recordatorios personales de la
      cuenta con sesión activa. No se respalda en la nube del dispositivo para
      evitar que una copia se restaure en otro equipo y quede asociada a una
      cuenta distinta. La copia autorizada vive en Firestore.
    -->
    <application
        android:name=".ReminderApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.API1ELIASESCALANTEPM"
        tools:targetApi="31">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.API1ELIASESCALANTEPM"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
